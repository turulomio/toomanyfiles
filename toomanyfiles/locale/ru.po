msgid "Configuration file '{}' already exists."
msgstr "Файл конфигурации '{}' уже существует."

msgid "Configuration file '{}' created successfully."
msgstr "Файл конфигурации '{}' успешно создан."

msgid "Configuration file '{}' not found. Use --create to create one."
msgstr "Файл конфигурации '{}' не найден. Используйте --create для его создания."

msgid "Error reading configuration file '{}': {}"
msgstr "Ошибка при чтении файла конфигурации '{}': {}"

msgid "Configuration file '{}' must contain a JSON array/list."
msgstr "Файл конфигурации '{}' должен содержать массив/список JSON."

msgid "Configuration item #{} is not a JSON object/dict."
msgstr "Элемент конфигурации #{} не является объектом/словарем JSON."

msgid "CONFIGURATION #{}: FILES TO PROCESS"
msgstr "КОНФИГУРАЦИЯ #{}: ФАЙЛЫ ДЛЯ ОБРАБОТКИ"

msgid "CONFIGURATION #{}: FILES IGNORED"
msgstr "КОНФИГУРАЦИЯ #{}: ПРОИГНОРИРОВАННЫЕ ФАЙЛЫ"

msgid "Search date and time patterns to delete unnecessary files or directories using a JSON configuration file"
msgstr "Поиск шаблонов даты и времени для удаления ненужных файлов или каталогов с помощью файла конфигурации JSON"

msgid "Developed by Mariano Muñoz 2018-{}"
msgstr "Разработано Mariano Muñoz 2018-{}"

msgid "Creates a default TooManyFiles.json configuration file in current directory"
msgstr "Создает файл конфигурации TooManyFiles.json по умолчанию в текущем каталоге"

msgid "Removes files permanently according to TooManyFiles.json"
msgstr "Окончательно удаляет файлы в соответствии с TooManyFiles.json"

msgid "Makes a simulation and doesn't remove files according to TooManyFiles.json"
msgstr "Выполняет симуляцию без удаления файлов в соответствии с TooManyFiles.json"

msgid "List files included and excluded for each configuration in TooManyFiles.json"
msgstr "Выводит список включенных и исключенных файлов для каждой конфигурации в TooManyFiles.json"

msgid "vhs tool is needed. Look at https://github.com/charmbracelet/vhs"
msgstr "Требуется утилита vhs. См. https://github.com/charmbracelet/vhs"

msgid "Invalid target '{}'. Choose from: command, howto, json, tree, all"
msgstr "Недопустимая цель '{}'. Выберите из: command, howto, json, tree, all"

msgid "New Release:"
msgstr "Новый релиз:"

msgid "  * Change version and date in __init__.py"
msgstr "  * Изменить версию и дату в __init__.py"

msgid "  * Change version in pyproject.toml"
msgstr "  * Изменить версию в pyproject.toml"

msgid "  * Edit Changelog in README.md"
msgstr "  * Отредактировать Changelog в README.md"

msgid "  * Make a new tag in github"
msgstr "  * Создать новый тег на GitHub"

msgid "  * Create a new gentoo ebuild with the new version"
msgstr "  * Создать новый ebuild для gentoo с новой версией"

msgid "  * Upload to portage repository"
msgstr "  * Загрузить в репозиторий portage"

msgid "Different examples have been created in the directory 'toomanyfiles_examples'"
msgstr "Созданы различные примеры в каталоге 'toomanyfiles_examples'"

msgid "'toomanyfiles_examples' directory removed"
msgstr "Каталог 'toomanyfiles_examples' удалён"

msgid "I can't remove 'toomanyfiles_examples' directory"
msgstr "Не удалось удалить каталог 'toomanyfiles_examples'"

msgid "{} TooManyFiles in {} detected {} files with time pattern {} and filename patterns {}"
msgstr "{} TooManyFiles в {} обнаружил {} файлов с шаблоном времени {} и шаблонами имён {}"

msgid "R"
msgstr "С"

msgid "D"
msgstr "У"

msgid "Y"
msgstr "Н"

msgid "O"
msgstr "П"

msgid "   Parameters: Too young to delete:"
msgstr "   Параметры: Слишком новые для удаления:"

msgid "Max files to store:"
msgstr "Макс. файлов для хранения:"

msgid "Files status pretending:"
msgstr "Статус файлов в режиме симуляции:"

msgid "So, {} files will be deleted and {} will be kept when you use --remove parameter."
msgstr "Таким образом, {} файлов будет удалено и {} сохранено при использовании параметра --remove."

msgid "File status removing:"
msgstr "Статус файлов при удалении:"

msgid "So, {} files have been deleted and {} files have been kept."
msgstr "Таким образом, {} файлов удалено и {} файлов сохранено."

msgid "Remains"
msgstr "Остаётся"

msgid "Delete"
msgstr "Удалить"

msgid "Too young to delete"
msgstr "Слишком новый для удаления"

msgid "Over max files"
msgstr "Превышение макс. количества файлов"

msgid "Directory"
msgstr "Каталог"

msgid "File"
msgstr "Файл"

msgid "File patterns weren't found"
msgstr "Шаблоны имён файлов не найдены"

msgid "Time pattern wasn't found"
msgstr "Шаблон времени не найден"

msgid "The number of files too young to delete can't be bigger than the maximum number of files to store"
msgstr "Количество файлов, слишком новых для удаления, не может быть больше максимального количества файлов для хранения"

msgid "Not developed yet"
msgstr "Ещё не разработано"

msgid "Over max number of files"
msgstr "Превышает максимальное количество файлов"

msgid "Search date and time patterns to delete innecesary files or directories"
msgstr "Поиск шаблонов даты и времени для удаления ненужных файлов или каталогов"

msgid "Removes files permanently"
msgstr "Удаляет файлы безвозвратно"

msgid "Makes a simulation and doesn't remove files"
msgstr "Выполняет симуляцию и не удаляет файлы"

msgid "List files included and excluded"
msgstr "Список включённых и исключённых файлов"

msgid "Modifiers to use with --remove and --pretend"
msgstr "Модификаторы для использования с --remove и --pretend"

#, python-format
msgid "Defines a python datetime pattern to search in current directory. The default pattern is '%(default)s'."
msgstr "Определяет шаблон даты и времени python для поиска в текущем каталоге. Шаблон по умолчанию: '%(default)s'."

#, python-format
msgid "Defines one or several string patterns to search in path with matches time pattern. Patterns are case sensitive and filename must have all to be selected. The default pattern is '%(default)s'."
msgstr "Определяет один или несколько строковых шаблонов для поиска в пути, соответствующем шаблону времени. Шаблоны чувствительны к регистру, и имя файла должно содержать их все для выбора. Шаблон по умолчанию: '%(default)s'."

#, python-format
msgid "Disable log generation. The default value is '%(default)s'."
msgstr "Отключить генерацию журнала. Значение по умолчанию: '%(default)s'."

#, python-format
msgid "Remove mode. The default value is '%(default)s'."
msgstr "Режим удаления. Значение по умолчанию: '%(default)s'."

#, python-format
msgid "Number of days to respect from today. The default value is '%(default)s'."
msgstr "Количество дней от сегодняшней даты, файлы за которые не удаляются. Значение по умолчанию: '%(default)s'."

#, python-format
msgid "Maximum number of files to remain in directory. The default value is '%(default)s'."
msgstr "Максимальное количество файлов, остающихся в каталоге. Значение по умолчанию: '%(default)s'."

msgid "FILES TO PROCESS"
msgstr "ФАЙЛЫ ДЛЯ ОБРАБОТКИ"

msgid "FILES IGNORED"
msgstr "ПРОПУЩЕННЫЕ ФАЙЛЫ"

msgid "DIRECTORY"
msgstr "КАТАЛОГ"

msgid "FILE"
msgstr "ФАЙЛ"

#, python-brace-format
msgid "Time pattern found: ({0})"
msgstr "Найден шаблон времени: ({0})"

msgid "No '{}' files found in directory tree under '{}'."
msgstr "Файлы '{}' не найдены в дереве каталогов под '{}'."

msgid "Found {} configuration directory(ies) under '{}':"
msgstr "Найдено {} каталог(ов) конфигурации под '{}':"

msgid "Processing directory: {}"
msgstr "Обработка каталога: {}"

msgid "Recursively search and execute all TooManyFiles.json configuration files in a directory tree"
msgstr "Рекурсивный поиск и выполнение всех файлов конфигурации TooManyFiles.json в дереве каталогов"

msgid "Removes files permanently according to all TooManyFiles.json found in tree"
msgstr "Окончательно удаляет файлы в соответствии со всеми TooManyFiles.json, найденными в дереве"

msgid "Makes a simulation and doesn't remove files according to all TooManyFiles.json found in tree"
msgstr "Выполняет симуляцию без удаления файлов в соответствии со всеми TooManyFiles.json, найденными в дереве"

msgid "List files included and excluded for each TooManyFiles.json found in tree"
msgstr "Выводит список включенных и исключенных файлов для каждого TooManyFiles.json, найденного в дереве"

msgid "Shows detailed output for each configuration"
msgstr "Показывает подробный вывод для каждой конфигурации"

