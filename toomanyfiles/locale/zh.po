#, python-format
msgid "Defines a python datetime pattern to search in current directory. The default pattern is '%(default)s'."
msgstr "定义在当前目录中搜索的 Python 日期时间模式。默认模式为 '%(default)s'。"

#, python-format
msgid "Defines one or several string patterns to search in path with matches time pattern. Patterns are case sensitive and filename must have all to be selected. The default pattern is '%(default)s'."
msgstr "定义在与时间模式匹配的路径中搜索的一个或多个字符串模式。模式区分大小写，文件名必须包含所有模式才会被选中。默认模式为 '%(default)s'。"

#, python-format
msgid "Disable log generation. The default value is '%(default)s'."
msgstr "禁用日志生成。默认值为 '%(default)s'。"

#, python-format
msgid "Remove mode. The default value is '%(default)s'."
msgstr "删除模式。默认值为 '%(default)s'。"

#, python-format
msgid "Number of days to respect from today. The default value is '%(default)s'."
msgstr "从今天起保留的天数。默认值为 '%(default)s'。"

#, python-format
msgid "Maximum number of files to remain in directory. The default value is '%(default)s'."
msgstr "目录中保留的最大文件数。默认值为 '%(default)s'。"

