msgid "Configuration file '{}' already exists."
msgstr "Fișierul de configurare '{}' există deja."

msgid "Configuration file '{}' created successfully."
msgstr "Fișierul de configurare '{}' a fost creat cu succes."

msgid "Configuration file '{}' not found. Use --create to create one."
msgstr "Fișierul de configurare '{}' nu a fost găsit. Utilizați --create pentru a crea unul."

msgid "Error reading configuration file '{}': {}"
msgstr "Eroare la citirea fișierului de configurare '{}': {}"

msgid "Configuration file '{}' must contain a JSON array/list."
msgstr "Fișierul de configurare '{}' trebuie să conțină o matrice/listă JSON."

msgid "Configuration item #{} is not a JSON object/dict."
msgstr "Elementul de configurare #{} nu este un obiect/dicționar JSON."

msgid "CONFIGURATION #{}: FILES TO PROCESS"
msgstr "CONFIGURAȚIA #{}: FIȘIERE DE PROCESAT"

msgid "CONFIGURATION #{}: FILES IGNORED"
msgstr "CONFIGURAȚIA #{}: FIȘIERE IGNORATE"

msgid "Search date and time patterns to delete unnecessary files or directories using a JSON configuration file"
msgstr "Căutați tipare de dată și oră pentru a șterge fișiere sau directoare inutile utilizând un fișier de configurare JSON"

msgid "Developed by Mariano Muñoz 2018-{}"
msgstr "Dezvoltat de Mariano Muñoz 2018-{}"

msgid "Creates a default toomanyfiles.json configuration file in current directory"
msgstr "Creează un fișier de configurare toomanyfiles.json implicit în directorul curent"

msgid "Removes files permanently according to toomanyfiles.json"
msgstr "Șterge definitiv fișierele conform toomanyfiles.json"

msgid "Makes a simulation and doesn't remove files according to toomanyfiles.json"
msgstr "Efectuează o simulare și nu șterge fișierele conform toomanyfiles.json"

msgid "List files included and excluded for each configuration in toomanyfiles.json"
msgstr "Listează fișierele incluse și excluse pentru fiecare configurație din toomanyfiles.json"

msgid "vhs tool is needed. Look at https://github.com/charmbracelet/vhs"
msgstr "Este necesar instrumentul vhs. Consultați https://github.com/charmbracelet/vhs"

msgid "New Release:"
msgstr "Versiune nouă:"

msgid "  * Change version and date in __init__.py"
msgstr "  * Schimbați versiunea și data în __init__.py"

msgid "  * Change version in pyproject.toml"
msgstr "  * Schimbați versiunea în pyproject.toml"

msgid "  * Edit Changelog in README.md"
msgstr "  * Editați Changelog în README.md"

msgid "  * Make a new tag in github"
msgstr "  * Creați o etichetă nouă pe GitHub"

msgid "  * Create a new gentoo ebuild with the new version"
msgstr "  * Creați un ebuild gentoo nou cu noua versiune"

msgid "  * Upload to portage repository"
msgstr "  * Încărcați în depozitul portage"

msgid "Different examples have been created in the directory 'toomanyfiles_examples'"
msgstr "Au fost create diferite exemple în directorul 'toomanyfiles_examples'"

msgid "'toomanyfiles_examples' directory removed"
msgstr "Directorul 'toomanyfiles_examples' a fost eliminat"

msgid "I can't remove 'toomanyfiles_examples' directory"
msgstr "Nu se poate elimina directorul 'toomanyfiles_examples'"

msgid "{} TooManyFiles in {} detected {} files with time pattern {} and filename patterns {}"
msgstr "{} TooManyFiles în {} a detectat {} fișiere cu modelul de timp {} și modelele de nume {}"

msgid "R"
msgstr "P"

msgid "D"
msgstr "Ș"

msgid "Y"
msgstr "R"

msgid "O"
msgstr "D"

msgid "   Parameters: Too young to delete:"
msgstr "   Parametri: Prea recente pentru ștergere:"

msgid "Max files to store:"
msgstr "Nr. maxim de fișiere de stocat:"

msgid "Files status pretending:"
msgstr "Starea fișierelor în simulare:"

msgid "So, {} files will be deleted and {} will be kept when you use --remove parameter."
msgstr "Astfel, {} fișiere vor fi șterse și {} vor fi păstrate la utilizarea parametrului --remove."

msgid "File status removing:"
msgstr "Starea fișierelor la ștergere:"

msgid "So, {} files have been deleted and {} files have been kept."
msgstr "Astfel, {} fișiere au fost șterse și {} fișiere au fost păstrate."

msgid "Remains"
msgstr "Păstrat"

msgid "Delete"
msgstr "Ștergere"

msgid "Too young to delete"
msgstr "Prea recent pentru ștergere"

msgid "Over max files"
msgstr "Peste numărul maxim de fișiere"

msgid "Directory"
msgstr "Director"

msgid "File"
msgstr "Fișier"

msgid "File patterns weren't found"
msgstr "Modelele de nume de fișier nu au fost găsite"

msgid "Time pattern wasn't found"
msgstr "Modelul de timp nu a fost găsit"

msgid "The number of files too young to delete can't be bigger than the maximum number of files to store"
msgstr "Numărul de fișiere prea recente pentru ștergere nu poate fi mai mare decât numărul maxim de fișiere de stocat"

msgid "Not developed yet"
msgstr "Nu este dezvoltat încă"

msgid "Over max number of files"
msgstr "Depășește numărul maxim de fișiere"

msgid "Search date and time patterns to delete innecesary files or directories"
msgstr "Căutați modele de dată și oră pentru a șterge fișiere sau directoare inutile"

msgid "Removes files permanently"
msgstr "Șterge fișierele definitiv"

msgid "Makes a simulation and doesn't remove files"
msgstr "Efectuează o simulare și nu șterge fișierele"

msgid "List files included and excluded"
msgstr "Listează fișierele incluse și excluse"

msgid "Modifiers to use with --remove and --pretend"
msgstr "Modificatori de utilizat cu --remove și --pretend"

#, python-format
msgid "Defines a python datetime pattern to search in current directory. The default pattern is '%(default)s'."
msgstr "Definește un model python datetime de căutat în directorul curent. Modelul implicit este '%(default)s'."

#, python-format
msgid "Defines one or several string patterns to search in path with matches time pattern. Patterns are case sensitive and filename must have all to be selected. The default pattern is '%(default)s'."
msgstr "Definește unul sau mai multe modele de text de căutat în cale care corespund modelului de timp. Modelele sunt sensibile la majuscule/minuscule și numele fișierului trebuie să le conțină pe toate pentru a fi selectat. Modelul implicit este '%(default)s'."

#, python-format
msgid "Disable log generation. The default value is '%(default)s'."
msgstr "Dezactivează generarea jurnalului. Valoarea implicită este '%(default)s'."

#, python-format
msgid "Remove mode. The default value is '%(default)s'."
msgstr "Mod de ștergere. Valoarea implicită este '%(default)s'."

#, python-format
msgid "Number of days to respect from today. The default value is '%(default)s'."
msgstr "Numărul de zile de păstrat începând de astăzi. Valoarea implicită este '%(default)s'."

#, python-format
msgid "Maximum number of files to remain in directory. The default value is '%(default)s'."
msgstr "Numărul maxim de fișiere care rămân în director. Valoarea implicită este '%(default)s'."

msgid "FILES TO PROCESS"
msgstr "FIȘIERE DE PROCESAT"

msgid "FILES IGNORED"
msgstr "FIȘIERE IGNORATE"

msgid "DIRECTORY"
msgstr "DIRECTOR"

msgid "FILE"
msgstr "FIȘIER"

#, python-brace-format
msgid "Time pattern found: ({0})"
msgstr "Model de timp găsit: ({0})"

msgid "No '{}' files found in directory tree under '{}'."
msgstr "Nu s-au găsit fișiere '{}' în arborele de directoare sub '{}'."

msgid "Found {} configuration directory(ies) under '{}':"
msgstr "S-au găsit {} director(oare) de configurare sub '{}':"

msgid "Processing directory: {}"
msgstr "Se procesează directorul: {}"

msgid "Recursively search and execute all toomanyfiles.json configuration files in a directory tree"
msgstr "Căutați și executați recursiv toate fișierele de configurare toomanyfiles.json dintr-un arbore de directoare"

msgid "Removes files permanently according to all toomanyfiles.json found in tree"
msgstr "Șterge definitiv fișierele conform tuturor fișierelor toomanyfiles.json găsite în arbore"

msgid "Makes a simulation and doesn't remove files according to all toomanyfiles.json found in tree"
msgstr "Efectuează o simulare și nu șterge fișierele conform tuturor fișierelor toomanyfiles.json găsite în arbore"

msgid "List files included and excluded for each toomanyfiles.json found in tree"
msgstr "Listează fișierele incluse și excluse pentru fiecare toomanyfiles.json găsit în arbore"

msgid "Shows detailed output for each configuration"
msgstr "Afișează ieșirea detaliată pentru fiecare configurație"

#~ msgid "Processing directories"
#~ msgstr "Se procesează directoarele"
