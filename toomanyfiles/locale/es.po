msgid "Configuration file '{}' already exists."
msgstr "El archivo de configuración '{}' ya existe."

msgid "Configuration file '{}' created successfully."
msgstr "Archivo de configuración '{}' creado correctamente."

msgid "Configuration file '{}' not found. Use --create to create one."
msgstr "No se ha encontrado el archivo de configuración '{}'. Usa --create para crear uno."

msgid "Error reading configuration file '{}': {}"
msgstr "Error al leer el archivo de configuración '{}': {}"

msgid "Configuration file '{}' must contain a JSON array/list."
msgstr "El archivo de configuración '{}' debe contener una lista/array JSON."

msgid "Configuration item #{} is not a JSON object/dict."
msgstr "El elemento de configuración #{} no es un objeto/diccionario JSON."

msgid "CONFIGURATION #{}: FILES TO PROCESS"
msgstr "CONFIGURACIÓN #{}: ARCHIVOS A PROCESAR"

msgid "CONFIGURATION #{}: FILES IGNORED"
msgstr "CONFIGURACIÓN #{}: ARCHIVOS IGNORADOS"

msgid "Search date and time patterns to delete unnecessary files or directories using a JSON configuration file"
msgstr "Busca patrones de fecha y hora para eliminar archivos o directorios innecesarios usando un archivo de configuración JSON"

msgid "Developed by Mariano Muñoz 2018-{}"
msgstr "Desarrollado por Mariano Muñoz 2018-{}"

msgid "Creates a default toomanyfiles.json configuration file in current directory"
msgstr "Crea un archivo de configuración toomanyfiles.json por defecto en el directorio actual"

msgid "Removes files permanently according to toomanyfiles.json"
msgstr "Elimina archivos permanentemente según toomanyfiles.json"

msgid "Makes a simulation and doesn't remove files according to toomanyfiles.json"
msgstr "Realiza una simulación y no elimina archivos según toomanyfiles.json"

msgid "List files included and excluded for each configuration in toomanyfiles.json"
msgstr "Lista los archivos incluidos y excluidos para cada configuración en toomanyfiles.json"

msgid "vhs tool is needed. Look at https://github.com/charmbracelet/vhs"
msgstr "Se necesita la herramienta vhs. Visita https://github.com/charmbracelet/vhs"

msgid "New Release:"
msgstr "Nueva versión:"

msgid "  * Change version and date in __init__.py"
msgstr "  * Cambiar la versión y la fecha en __init__.py"

msgid "  * Change version in pyproject.toml"
msgstr "  * Cambiar la versión en pyproject.toml"

msgid "  * Edit Changelog in README.md"
msgstr "  * Editar el Changelog en README.md"

msgid "  * Make a new tag in github"
msgstr "  * Crear una nueva etiqueta en github"

msgid "  * Create a new gentoo ebuild with the new version"
msgstr "  * Crear un nuevo ebuild de gentoo con la nueva versión"

msgid "  * Upload to portage repository"
msgstr "  * Subir al repositorio de portage"

msgid "Different examples have been created in the directory 'toomanyfiles_examples'"
msgstr "Se han creado diferentes ejemplos en el directorio 'toomanyfiles_examples'"

msgid "'toomanyfiles_examples' directory removed"
msgstr "Directorio 'toomanyfiles_examples' eliminado"

msgid "I can't remove 'toomanyfiles_examples' directory"
msgstr "No se puede eliminar el directorio 'toomanyfiles_examples'"

msgid "{} TooManyFiles in {} detected {} files with time pattern {} and filename patterns {}"
msgstr "{} TooManyFiles en {} ha detectado {} ficheros con el patrón de tiempo {} y los patrones de nombre {}"

msgid "R"
msgstr "P"

msgid "D"
msgstr "B"

msgid "Y"
msgstr "J"

msgid "O"
msgstr "S"

msgid "   Parameters: Too young to delete:"
msgstr "   Parámetros: Demasiado recientes para borrar:"

msgid "Max files to store:"
msgstr "Máx. ficheros a guardar:"

msgid "Files status pretending:"
msgstr "Estado de los ficheros en la simulación:"

msgid "So, {} files will be deleted and {} will be kept when you use --remove parameter."
msgstr "De esta manera, {} ficheros serán borrados y {} serán guardados cuando uses el parámetro --remove."

msgid "File status removing:"
msgstr "Estado de los ficheros para borrar:"

msgid "So, {} files have been deleted and {} files have been kept."
msgstr "De esta manera, {} ficheros se han borrado y {} ficheros se han guardado."

msgid "Remains"
msgstr "Permanece"

msgid "Delete"
msgstr "Borrado"

msgid "Too young to delete"
msgstr "Muy joven para borrar"

msgid "Over max files"
msgstr "Supera el número de ficheros a guardar"

msgid "Directory"
msgstr "Directorio"

msgid "File"
msgstr "Fichero"

msgid "File patterns weren't found"
msgstr "No se encontraron los patrones de archivo"

msgid "Time pattern wasn't found"
msgstr "No se encontró el patrón de tiempo"

msgid "The number of files too young to delete can't be bigger than the maximum number of files to store"
msgstr "El número de ficheros demasiado recientes para ser borrados no puede ser mayor que el máximo número de ficheros a guardar"

msgid "Not developed yet"
msgstr "No desarrollado todavía"

msgid "Over max number of files"
msgstr "Supera el número máximo de ficheros"

msgid "Search date and time patterns to delete innecesary files or directories"
msgstr "Busca patrones de fecha y hora para borrar ficheros o directorios innecesarios"

msgid "Removes files permanently"
msgstr "Borra los ficheros permanentemente"

msgid "Makes a simulation and doesn't remove files"
msgstr "Realiza una simulación y no borra los ficheros"

msgid "List files included and excluded"
msgstr "Listado de ficheros incluidos y excluidos"

msgid "Modifiers to use with --remove and --pretend"
msgstr "Modificadores a usar con --remove y --pretend"

#, python-format
msgid "Defines a python datetime pattern to search in current directory. The default pattern is '%(default)s'."
msgstr "Define un patrón de fecha y hora de python a buscar en el directorio actual. El patrón por defecto es '%(default)s'."

#, python-format
msgid "Defines one or several string patterns to search in path with matches time pattern. Patterns are case sensitive and filename must have all to be selected. The default pattern is '%(default)s'."
msgstr "Define uno o varios patrones de texto a buscar en la ruta que coincida con el patrón de tiempo. Los patrones distinguen mayúsculas y minúsculas y el nombre del fichero debe tener todos para ser seleccionado. El patrón por defecto es '%(default)s'."

#, python-format
msgid "Disable log generation. The default value is '%(default)s'."
msgstr "Deshabilita la generación del registro. El valor por defecto es '%(default)s'."

#, python-format
msgid "Remove mode. The default value is '%(default)s'."
msgstr "Modo de borrado. El valor por defecto es '%(default)s'."

#, python-format
msgid "Number of days to respect from today. The default value is '%(default)s'."
msgstr "Número de días que se respetan desde hoy. El valor por defecto es '%(default)s'."

#, python-format
msgid "Maximum number of files to remain in directory. The default value is '%(default)s'."
msgstr "Máximo número de ficheros que quedarán en el directorio. El valor por defecto es '%(default)s'."

msgid "FILES TO PROCESS"
msgstr "FICHEROS A PROCESAR"

msgid "FILES IGNORED"
msgstr "FICHEROS IGNORADOS"

msgid "DIRECTORY"
msgstr "DIRECTORIO"

msgid "FILE"
msgstr "FICHERO"

#, python-brace-format
msgid "Time pattern found: ({0})"
msgstr "Patrón de tiempo encontrado: ({0})"

msgid "No '{}' files found in directory tree under '{}'."
msgstr "No se han encontrado archivos '{}' en el árbol de directorios bajo '{}'."

msgid "Found {} configuration directory(ies) under '{}':"
msgstr "Se encontraron {} directorio(s) de configuración bajo '{}':"

msgid "Processing directory: {}"
msgstr "Procesando directorio: {}"

msgid "Recursively search and execute all toomanyfiles.json configuration files in a directory tree"
msgstr "Busca y ejecuta recursivamente todos los archivos de configuración toomanyfiles.json en un árbol de directorios"

msgid "Removes files permanently according to all toomanyfiles.json found in tree"
msgstr "Elimina archivos permanentemente según todos los toomanyfiles.json encontrados en el árbol"

msgid "Makes a simulation and doesn't remove files according to all toomanyfiles.json found in tree"
msgstr "Realiza una simulación y no elimina archivos según todos los toomanyfiles.json encontrados en el árbol"

msgid "List files included and excluded for each toomanyfiles.json found in tree"
msgstr "Lista los archivos incluidos y excluidos para cada toomanyfiles.json encontrado en el árbol"

msgid "Shows detailed output for each configuration"
msgstr "Muestra información detallada para cada configuración"

#~ msgid "Processing directories"
#~ msgstr "Procesando directorios"
